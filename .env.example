# Produção Vercel: banco SQLite remoto (Turso / libSQL)
TURSO_DATABASE_URL=libsql://SEU-BANCO.turso.io
TURSO_AUTH_TOKEN=COLE_TOKEN_PRIVADO
# Somente desenvolvimento local, se não usar TURSO_DATABASE_URL:
LOCAL_DATABASE_URL=file:./dados/jardimjs.db
# Defina uma senha longa e diferente para o professor
ADMIN_PASSWORD=ALTERAR_ANTES_DE_PUBLICAR
# Use segredo aleatório e estável (ex.: openssl rand -hex 32)
SESSION_SECRET=ALTERAR_COM_SEGREDO_ALEATORIO
# Opcional: restringe chamadas de origem em produção (ex: https://meu-site.vercel.app)
APP_ORIGIN=
